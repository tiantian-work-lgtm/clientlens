# Server-side secrets. Never expose these with NEXT_PUBLIC_ prefixes.
# Persistent PostgreSQL database.
POSTGRES_DB=clientlens
POSTGRES_USER=clientlens
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://clientlens:CHANGE_ME@db:5432/clientlens

# Generate independent secrets. Keep them outside Git and database backups.
SETTINGS_ENCRYPTION_KEY=
AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional legacy fallback. New provider keys are encrypted in PostgreSQL.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
SALESMARTLY_API_KEY=
SALESMARTLY_BASE_URL=
